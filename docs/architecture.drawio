rent="1" source="v13" target="v19"><mxGeometry x="0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="520"/><mxPoint x="300" y="232"/><mxPoint x="870" y="232"/></Array></mxGeometry></mxCell><mxCell id="e49" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#DD344C;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v20"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#DD344C;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v21"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="345"/><mxPoint x="980" y="395"/></Array></mxGeometry></mxCell><mxCell id="e51" value="4a Subscribe email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#01A88D;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="v21" target="v22"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="348"/><mxPoint x="1420" y="348"/><mxPoint x="1420" y="340"/></Array></mxGeometry></mxCell><mxCell id="e52" value="4b Profile item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#DD344C;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v21" target="v31"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="640"/></Array></mxGeometry></mxCell><mxCell id="e53" value="5 HTTPS + ID token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#8C4FFF;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v13" target="v23"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="545"/><mxPoint x="240" y="680"/></Array></mxGeometry></mxCell><mxCell id="e54" value="5a Validate JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD344C;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#DD344C;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v23" target="v19"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="470"/><mxPoint x="885" y="470"/></Array></mxGeometry></mxCell><mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#8C4FFF;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v23" target="v24"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e56" value="6 Read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#8C4FFF;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v24" target="v31"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#E7157B;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v31" target="v32"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e58" value="7 CreateSchedule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#ED7100;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v24" target="v33"><mxGeometry x="-0.72" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e59" value="8 Invoke at deadline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#ED7100;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v33" target="v34"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e60" value="9 Pending→Expired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#ED7100;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="v34" target="v31"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="897"/><mxPoint x="1365" y="897"/><mxPoint x="1365" y="702"/></Array></mxGeometry></mxCell><mxCell id="e61" value="10 Publish (userId attr)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#ED7100;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="v34" target="v22"><mxGeometry x="-0.15" relative="1" as="geometry"><Array as="points"><mxPoint x="1455" y="1015"/><mxPoint x="1455" y="315"/></Array></mxGeometry></mxCell><mxCell id="e62" value="11 Email to task owner only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#01A88D;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v22" target="v14"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e63" value="12 MODIFY→Completed / REMOVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#E7157B;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v32" target="v35"><mxGeometry x="-0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="1765" y="680"/><mxPoint x="1765" y="1280"/></Array></mxGeometry></mxCell><mxCell id="e64" value="13 SendMessage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#E7157B;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v35" target="v36"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="14 Poll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#E7157B;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v36" target="v38"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e66" value="15 DeleteSchedule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#E7157B;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v38" target="v33"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="1174"/><mxPoint x="760" y="1174"/><mxPoint x="760" y="1015"/></Array></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#E7157B;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v36" target="v37"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="1420"/></Array></mxGeometry></mxCell><mxCell id="e68" value="A git push → build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#545B64;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v15" target="v18"><mxGeometry x="-0.82" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e69" value="B git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#545B64;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v17"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e70" value="C Upload artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#545B64;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v40"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e71" value="D Deploy stack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#545B64;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v39"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="1650"/><mxPoint x="420" y="1015"/></Array></mxGeometry></mxCell><mxCell id="v72" value="&lt;div style=&quot;font-size:12px;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;How it works&lt;/b&gt;&lt;br&gt;&lt;table cellpadding=&quot;2&quot; style=&quot;font-size:11.5px;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; style=&quot;padding-right:18px&quot;&gt;&lt;b style=&quot;color:#DD344C&quot;&gt;Sign-up &amp;amp; sign-in&lt;/b&gt;&lt;br&gt;1 Browser loads the React SPA from Amplify Hosting.&lt;br&gt;2 User signs up / signs in against the Cognito User Pool.&lt;br&gt;3 PreSignUp λ auto-confirms the user (no verification code).&lt;br&gt;4 PostAuthentication λ subscribes the email to SNS with a&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;filter policy on the user id, and saves a profile item.&lt;br&gt;&lt;b style=&quot;color:#8C4FFF&quot;&gt;Task CRUD&lt;/b&gt;&lt;br&gt;5 SPA calls API Gateway with the Cognito ID token; the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Cognito authorizer validates it (5a).&lt;br&gt;6 CRUD Lambdas read/write the single DynamoDB table.&lt;br&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot; style=&quot;padding-right:18px&quot;&gt;&lt;b style=&quot;color:#ED7100&quot;&gt;Expiry (deadline, default +5 min)&lt;/b&gt;&lt;br&gt;7 CreateTask creates a one-time schedule task-&amp;lt;id&amp;gt;.&lt;br&gt;8 At the deadline Scheduler invokes ExpireTask λ.&lt;br&gt;9 Conditional update: only a Pending task becomes Expired.&lt;br&gt;10 ExpireTask publishes to SNS with userId attribute …&lt;br&gt;11 … so only the owner's subscription emails them.&lt;br&gt;&lt;b style=&quot;color:#E7157B&quot;&gt;Cancellation (complete / delete)&lt;/b&gt;&lt;br&gt;12 The change lands on the DynamoDB Stream.&lt;br&gt;13 StreamToQueue λ forwards it to SQS FIFO (per-task order).&lt;br&gt;14–15 CancelExpiry λ deletes the schedule; repeats are no-ops.&lt;br&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot;&gt;&lt;b style=&quot;color:#545B64&quot;&gt;CI/CD&lt;/b&gt;&lt;br&gt;A Frontend push → Amplify build.&lt;br&gt;B–D Backend push → GitHub Actions →&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sam build → S3 → CloudFormation.&lt;br&gt;&lt;b style=&quot;color:#7AA116&quot;&gt;Observability&lt;/b&gt;&lt;br&gt;Logs, metrics, alarms in CloudWatch;&lt;br&gt;traces in X-Ray; one IAM role per function.&lt;br&gt;&lt;b&gt;Safety net&lt;/b&gt;&lt;br&gt;If a cancel loses the race, step 9's condition&lt;br&gt;still stops the expiry and the email.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="700" y="1580" width="1680" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="DynamoDB design" id="dynamodb"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v73" value="&lt;div style=&quot;font-size:12px&quot;&gt;&lt;b style=&quot;font-size:20px&quot;&gt;DynamoDB single-table design · todo-dev-table&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64&quot;&gt;On-demand capacity · Streams NEW_AND_OLD_IMAGES · point-in-time recovery · SSE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;Entity&lt;/th&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;PK&lt;/th&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;SK&lt;/th&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;GSI1PK&lt;/th&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;GSI1SK&lt;/th&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;Other attributes&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;&lt;b&gt;Task&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;USER#&amp;lt;sub&amp;gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;TASK#&amp;lt;taskId&amp;gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;USER#&amp;lt;sub&amp;gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;STATUS#&amp;lt;Status&amp;gt;#&amp;lt;timestamp&amp;gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;TaskId (UUID), UserId, Email, Description, Date, Status (Pending | Completed | Expired), Deadline (epoch), DeadlineISO, ScheduleName, ScheduleGroup, CreatedAt, UpdatedAt, CompletedAt, ExpiredAt, NotifiedAt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;&lt;b&gt;User profile&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;USER#&amp;lt;sub&amp;gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;PROFILE&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Email, SubscriptionArn, SubscribedAt, UpdatedAt&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;Access pattern&lt;/th&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;Operation&lt;/th&gt;&lt;th style=&quot;background:#C925D1;color:#fff;padding:6px 10px;text-align:left&quot;&gt;Used by&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;List a user's tasks&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Query PK = USER#sub, SK begins_with TASK#&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;ListTasks&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;List a user's tasks by status&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Query GSI1: GSI1PK = USER#sub, GSI1SK begins_with STATUS#&amp;lt;status&amp;gt;#&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;ListTasks ?status=&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Get / update / delete one task&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Get/Update/DeleteItem on PK + SK (ownership enforced by the key)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Get/Update/DeleteTask&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Expire a task&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;UpdateItem with condition Status = Pending&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;ExpireTask&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Read / write subscription record&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;Get/PutItem PK = USER#sub, SK = PROFILE&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #E5E7EB;padding:6px 10px;vertical-align:top&quot;&gt;PostAuthentication&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Status lifecycle&lt;/b&gt;: Pending → Completed (user, PUT status=Completed) · Pending → Expired (ExpireTask at deadline). Completed and Expired are final; every transition is a conditional write, so the two can never both happen.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1300" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>